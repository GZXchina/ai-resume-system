@echo off
rem ============================================================
rem 本地密钥与口令配置模板
rem 使用方法：复制本文件为 ai-key.local.bat，填入自己的密钥与口令
rem ai-key.local.bat 已在 .gitignore 中忽略，不会被提交
rem ============================================================

rem ---- AI 服务（OpenAI 兼容接口）----
set "AI_API_KEY=<your-api-key>"
set "AI_ENDPOINT=https://api.deepseek.com/v1"
set "AI_MODEL=deepseek-chat"

rem ---- 本机 MySQL ----
set "DB_USERNAME=root"
set "DB_PASSWORD=<your-db-password>"

rem ---- 工具链路径（按本机实际安装位置填写）----
rem set "JAVA_HOME=C:\path\to\jdk-17"
rem set "MAVEN_HOME=C:\path\to\apache-maven-3.9.x"
